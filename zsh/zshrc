# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_dups hist_ignore_space
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^[[A' history-beginning-search-backward-end
bindkey '^[[B' history-beginning-search-forward-end

# Completion
[[ -d "$HOME/.docker/completions" ]] && fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
command -v kubectl &>/dev/null && source <(kubectl completion zsh)

# Plugins
if command -v brew &>/dev/null; then
  source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# fzf (Ctrl+R history, Ctrl+T file search, Alt+C cd)
source <(fzf --zsh)

# zoxide (smarter cd)
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# Prompt
autoload -Uz vcs_info
# allow parameter expansion inside $PROMPT
setopt prompt_subst

# Icy/mint palette: ice blue structure, theme-defined bright magenta branch, lavender action.
# formats: used during normal git state → git:(branch)
zstyle ':vcs_info:git:*' formats       '%F{#7dcfff}git:(%F{13}%b%F{#7dcfff})%f'
# actionformats: used when an action is in progress (merge, rebase, etc.) → git:(branch|merge)
zstyle ':vcs_info:git:*' actionformats '%F{#7dcfff}git:(%F{13}%b%F{#7dcfff}|%F{#c4b5e0}%a%F{#7dcfff})%f'

# Status glyph ● encodes state: green = clean, yellow = dirty, red·count = conflicts.
# ↑n ↓n show commits ahead/behind upstream. One `git status` call per prompt.
precmd() {
  local st branch
  st=$(git status --porcelain --branch 2>/dev/null)
  branch=${st%%$'\n'*}    # "## main...origin/main [ahead 2, behind 1]"
  st=${st#*$'\n'}; [[ $st == $branch ]] && st=''   # drop header; empty if header-only
  if [[ $st =~ $'(^|\n)(DD|AU|UD|UA|DU|AA|UU) ' ]]; then
    local n=$(print -r -- $st | grep -cE '^(DD|AU|UD|UA|DU|AA|UU) ')
    _git_status_glyph="%F{#f28b82}●$n%f"
  elif [[ -n $st ]]; then
    _git_status_glyph='%F{#e6c384}●%f'
  else
    _git_status_glyph='%F{#8bd5ca}●%f'
  fi
  [[ $branch =~ 'ahead ([0-9]+)'  ]] && _git_status_glyph+=" %F{#89ddff}↑$match[1]%f"
  [[ $branch =~ 'behind ([0-9]+)' ]] && _git_status_glyph+=" %F{#c4b5e0}↓$match[1]%f"
  vcs_info
}

# Prompt layout: ➜ dir git:(branch) ●
# %(?:...:...) → green ➜ on success, red on failure
# %1~          → current directory (last component only)
# vcs_info_msg_0_ → git info populated by precmd above (glyph only shown inside a repo)
PROMPT='%(?:%B%F{#8bd5ca}:%B%F{#f28b82})➜%f%b %B%F{#89ddff}%1~%f%b${vcs_info_msg_0_:+ %B$vcs_info_msg_0_%b $_git_status_glyph} '

# Aliases
if command -v eza &>/dev/null; then
  alias ls='eza'
  alias ll='eza -la --git'
  alias lt='eza --tree --level=2'
fi

# Functions

# hwt <name> <branch> [base] [herdr flags...]
# Creates a Herdr worktree next to the main checkout, bypassing Herdr's default location:
#   <project>/main layout → <project>/<name>
#   flat repo layout      → <parent>/<repo>-<name>
hwt() {
  if (( $# < 2 )); then
    print -u2 'usage: hwt <name> <branch> [base] [herdr flags...]'
    return 1
  fi
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir) || return
  local main=${common:h} dest
  if [[ ${main:t} == main ]]; then
    dest=${main:h}/$1
  else
    dest=${main:h}/${main:t}-$1
  fi
  local -a args=(--cwd "$PWD" --path "$dest" --branch "$2")
  [[ -n $3 ]] && args+=(--base "$3")
  herdr worktree create "${args[@]}" "${@:4}"
}

# Tools
eval "$(mise activate zsh)"
export PATH="$HOME/.local/bin:$PATH"

# Machine-local secrets and overrides (not committed)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
