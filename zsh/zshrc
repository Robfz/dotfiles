# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_dups hist_ignore_space
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^[[A' history-beginning-search-backward-end
bindkey '^[[B' history-beginning-search-forward-end

# Completion
[[ -d "$HOME/.docker/completions" ]] && fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
command -v kubectl &>/dev/null && source <(kubectl completion zsh)

# Plugins
if command -v brew &>/dev/null; then
  source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# fzf (Ctrl+R history, Ctrl+T file search, Alt+C cd)
source <(fzf --zsh)

# zoxide (smarter cd)
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# Prompt
autoload -Uz vcs_info
# allow parameter expansion inside $PROMPT
setopt prompt_subst

# formats: used during normal git state → git:(branch)
zstyle ':vcs_info:git:*' formats       '%F{blue}git:(%F{red}%b%F{blue})%f'
# actionformats: used when an action is in progress (merge, rebase, etc.) → git:(branch|merge)
zstyle ':vcs_info:git:*' actionformats '%F{blue}git:(%F{red}%b%F{blue}|%F{yellow}%a%F{blue})%f'

# Status glyph ● encodes state: green = clean, yellow = dirty, red·count = conflicts.
# ↑n ↓n show commits ahead/behind upstream. One `git status` call per prompt.
precmd() {
  local st branch
  st=$(git status --porcelain --branch 2>/dev/null)
  branch=${st%%$'\n'*}    # "## main...origin/main [ahead 2, behind 1]"
  st=${st#*$'\n'}; [[ $st == $branch ]] && st=''   # drop header; empty if header-only
  if [[ $st =~ $'(^|\n)(DD|AU|UD|UA|DU|AA|UU) ' ]]; then
    local n=$(print -r -- $st | grep -cE '^(DD|AU|UD|UA|DU|AA|UU) ')
    _git_status_glyph="%F{red}●$n%f"
  elif [[ -n $st ]]; then
    _git_status_glyph='%F{yellow}●%f'
  else
    _git_status_glyph='%F{green}●%f'
  fi
  [[ $branch =~ 'ahead ([0-9]+)'  ]] && _git_status_glyph+=" %F{cyan}↑$match[1]%f"
  [[ $branch =~ 'behind ([0-9]+)' ]] && _git_status_glyph+=" %F{cyan}↓$match[1]%f"
  vcs_info
}

# Prompt layout: ➜ dir git:(branch) ●
# %(?:...:...) → green ➜ on success, red on failure
# %1~          → current directory (last component only)
# vcs_info_msg_0_ → git info populated by precmd above (glyph only shown inside a repo)
PROMPT='%(?:%B%F{green}:%B%F{red})➜%f%b %B%F{cyan}%1~%f%b${vcs_info_msg_0_:+ %B$vcs_info_msg_0_%b $_git_status_glyph} '

# Tools
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Machine-local secrets and overrides (not committed)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
